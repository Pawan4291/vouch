{
  "name": "Vouch",
  "short_name": "Vouch",
  "description": "A staked-reputation marketplace for Nimiq Pay. Post deals, fund on-chain escrow, build reputation by vouching for people you trust. All state lives on Polygon — no backend.",
  "start_url": "/",
  "display": "standalone",
  "background_color": "#0d0920",
  "theme_color": "#1a1040",
  "orientation": "portrait-primary",
  "icons": [
    {
      "src": "/icon-192.png",
      "sizes": "192x192",
      "type": "image/png",
      "purpose": "any maskable"
    },
    {
      "src": "/icon-512.png",
      "sizes": "512x512",
      "type": "image/png",
      "purpose": "any"
    }
  ],
  "categories": ["marketplace", "finance", "productivity"],
  "nimiq": {
    "miniApp": true,
    "version": "1.0.0",
    "requiredProviders": ["nimiq", "ethereum"],
    "network": {
      "nim": "mainnet",
      "evm": {
        "chainId": 80002,
        "name": "Polygon Amoy Testnet"
      }
    },
    "permissions": [
      "nimiq:listAccounts",
      "nimiq:sendTransaction",
      "ethereum:requestAccounts",
      "ethereum:sendTransaction"
    ]
  }
}
